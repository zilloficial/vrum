# Endereço da API. No celular (Capacitor) use o IP da máquina na rede, ex.: http://192.168.0.10:3333
VITE_API_URL=http://localhost:3333

# Mapas (MapTiler). Sem a chave, usa o mapa gratuito da CARTO.
VITE_MAPTILER_KEY=
# Estilo do MapTiler (copie o ID no painel do MapTiler). Padrão: dataviz-dark
VITE_MAPTILER_ESTILO=dataviz-dark
