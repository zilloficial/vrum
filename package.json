{
  "name": "vrum",
  "private": true,
  "version": "0.1.0",
  "description": "VRUM — encontre profissionais automotivos, solicite atendimento e acompanhe a chegada em tempo real.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vrum/api",
    "dev:app": "npm run dev -w @vrum/app",
    "dev:painel": "npm run dev -w @vrum/painel",
    "build": "npm run build -w @vrum/app && npm run build -w @vrum/painel",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w @vrum/api",
    "db:seed": "npm run db:seed -w @vrum/api",
    "db:demo": "npm run db:demo -w @vrum/api"
  },
  "engines": {
    "node": ">=20"
  }
}
